<sdf version="1.9">
<world name="bee_platform">
	<physics name="1ms" type="ignored">
	<max_step_size>0.004</max_step_size>
	<real_time_factor>1.0</real_time_factor>
	</physics>
	<magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>

	<!-- =======================================================================
	     DETERMINISTIC WIND CONTROLLER

	     World frame is ENU:
	       +X = East, +Y = North, +Z = Up

	     The <wind> element creates Gazebo's world wind entity. WindController
	     publishes its time-varying velocity seed; WindEffects applies the
	     resulting force to links with <enable_wind>true</enable_wind>.
	     ======================================================================= -->
	<wind>
		<linear_velocity>0.0 0.0 0.0</linear_velocity>
	</wind>

	<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
	<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
	<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
	<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
	<plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
	<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
	<plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
	<plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
	<plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

	<spherical_coordinates>
	<surface_model>EARTH_WGS84</surface_model>
	<world_frame_orientation>ENU</world_frame_orientation>
	<latitude_deg>43.5297</latitude_deg>
	<longitude_deg>5.4474</longitude_deg>
	<elevation>0</elevation>
	<heading_deg>0</heading_deg>
	</spherical_coordinates>

	<light name="sun" type="directional">
	<cast_shadows>true</cast_shadows>
	<pose>0 0 10 0 0 0</pose>
	<diffuse>0.8 0.8 0.8 1</diffuse>
	<specular>0.2 0.2 0.2 1</specular>
	<direction>-0.5 0.1 -0.9</direction>
	</light>

	<model name="ground_plane">
	<static>true</static>
	<link name="ground_link">
		<collision name="collision">
		<geometry>
			<plane>
			<normal>0 0 1</normal>
			<size>2000 2000</size>
			</plane>
		</geometry>
		</collision>
		<visual name="visual">
		<geometry>
			<plane>
			<normal>0 0 1</normal>
			<size>2000 2000</size>
			</plane>
		</geometry>
		<material>
			<ambient>0.5 0.5 0.5 1</ambient>
			<diffuse>0.5 0.5 0.5 1</diffuse>
			<specular>0.0 0.0 0.0 1</specular>
			<pbr>
			<metal>
				<albedo_map>materials/textures/ground_grey.png</albedo_map>
				<!-- NO normal map -->
				<metalness>0.0</metalness>
				<roughness>1</roughness>
			</metal>
			</pbr>
		</material>
		</visual>
	</link>
	</model>

	<model name="bee_platform">
	<pose>0 0 2 0 0 0</pose>
	<static>false</static>

	<link name="platform_link">
	<gravity>false</gravity>
	<inertial>
		<mass>1000.0</mass>
		<inertia>
		<ixx>100.0</ixx>
		<iyy>100.0</iyy>
		<izz>100.0</izz>
		<ixy>0.0</ixy>
		<ixz>0.0</ixz>
		<iyz>0.0</iyz>
		</inertia>
	</inertial>
	<visual name="visual_body">
		<geometry>
		<cylinder>
			<radius>0.5</radius>
			<length>0.2</length>
		</cylinder>
		</geometry>
		<material>
		<ambient>0.55 0.35 0.18 1</ambient>
		<diffuse>0.55 0.35 0.18 1</diffuse>
		<specular>0.2 0.2 0.2 1</specular>
		</material>
	</visual>

	<visual name="visual_top">
		<!-- Slightly above the cylinder's top face (z=+length/2=0.1) to
		     avoid z-fighting with visual_body's cap. -->
		<pose>0 0 0.1005 0 0 0</pose>
		<geometry>
		<mesh>
			<uri>materials/meshes/flower_disc.obj</uri>
			<scale>0.5 0.5 1.0</scale>
		</mesh>
		</geometry>
		<material>
		<ambient>0.95 0.70 0.15 1</ambient>
		<diffuse>0.95 0.70 0.15 1</diffuse>
		<specular>0.2 0.2 0.2 1</specular>
		<pbr>
			<metal>
			<albedo_map>materials/textures/flower_top.png</albedo_map>
			<normal_map>materials/textures/flower_top_normal.png</normal_map>
			<metalness>0.0</metalness>
			<roughness>0.55</roughness>
			</metal>
		</pbr>
		</material>
	</visual>

	<!-- Physical deck.
	     Collision now matches the visible cylinder: no thick hidden platform,
	     no shifted invisible support. Because the model is non-static and gravity
	     is disabled above, this collision should move with the commanded platform
	     pose instead of behaving like a cached static obstacle. -->
	<collision name="collision">
		<geometry>
		<cylinder>
			<radius>0.5</radius>
			<length>0.2</length>
		</cylinder>
		</geometry>
		<surface>
		<friction>
			<ode>
			<mu>1.5</mu>
			<mu2>1.5</mu2>
			</ode>
		</friction>
		<contact>
			<ode>
			<kp>1000000</kp>
			<kd>100</kd>
			<max_vel>10.0</max_vel>
			<min_depth>0.001</min_depth>
			</ode>
		</contact>
		</surface>
	</collision>

	<!-- Contact sensor used by Gazebo's TouchPlugin to detect a real touchdown.
	     It is attached to the platform collision, so we don't need to know the
	     landing-gear collision names inside the included bee_x500/x500_base model. -->
	<sensor name="deck_contact_sensor" type="contact">
		<always_on>1</always_on>
		<update_rate>100</update_rate>
		<contact>
			<collision>collision</collision>
		</contact>
	</sensor>
	</link>



	<!-- ================================================================
		COHERENT MARINE ENVIRONMENT
		Wind -> wind sea -> correlated vessel response
		================================================================ -->

	<!-- Atmospheric wind.
		Use realistic-ish environmental velocity, but reduce Gazebo's
		linear force coefficient so the drone disturbance remains sensible. -->
	<plugin filename="libWindController.so"
			name="custom::WindController">

		<enabled>true</enabled>
		<seed>42</seed>

		<!-- prevailing wind -->
		<mean_velocity>6.0 0.0 0.0</mean_velocity>

		<!-- slow atmospheric gust, NOT wave-frequency vessel motion -->
		<axis_x>
			<component>
				<amplitude>0.60</amplitude>
				<frequency>0.030</frequency>
				<phase>0.0</phase>
			</component>
		</axis_x>

		<axis_y>
			<component>
				<amplitude>0.25</amplitude>
				<frequency>0.020</frequency>
				<phase>1.2</phase>
			</component>
		</axis_y>

		<axis_z/>

		<max_wind_speed>8.0</max_wind_speed>

		<wind_topic>/world/bee_platform/wind</wind_topic>
		<truth_topic>/bee_land/wind_cmd</truth_topic>
	</plugin>

	<!-- Gazebo's force model is very strong at k=1.
		k=0.08 gives ~0.48 m/s² at 6 m/s when nearly stationary. -->
	<plugin filename="gz-sim-wind-effects-system"
			name="gz::sim::systems::WindEffects">

		<force_approximation_scaling_factor>
			0.08
		</force_approximation_scaling_factor>

		<horizontal>
			<magnitude>
				<time_for_rise>0.004</time_for_rise>
			</magnitude>
			<direction>
				<time_for_rise>0.004</time_for_rise>
			</direction>
		</horizontal>

		<vertical>
			<time_for_rise>0.004</time_for_rise>
		</vertical>
	</plugin>


	<!-- ================================================================
		SHIP RESPONSE

		Underlying representative wave components:

		f1 = 0.10 Hz
		f2 = 0.16 Hz   <-- dominant
		f3 = 0.22 Hz

		Base wave phases:
		phi = 0.4, 2.0, 4.4 rad

		Every ship DOF uses THESE SAME frequencies.
		Amplitude and phase offsets approximate different RAOs.
		================================================================ -->

	<plugin filename="libOscillatingPlatformController.so"
			name="custom::OscillatingPlatformController">

		<link_name>platform_link</link_name>

		<!-- SURGE: waves mainly arriving along X -->
		<axis_x>
			<component>
				<amplitude>0.050</amplitude>
				<frequency>0.10</frequency>
				<phase>1.40</phase>
			</component>
			<component>
				<amplitude>0.040</amplitude>
				<frequency>0.16</frequency>
				<phase>3.00</phase>
			</component>
			<component>
				<amplitude>0.020</amplitude>
				<frequency>0.22</frequency>
				<phase>5.40</phase>
			</component>
		</axis_x>

		<!-- SWAY: smaller response for nearly head-on sea -->
		<axis_y>
			<component>
				<amplitude>0.015</amplitude>
				<frequency>0.10</frequency>
				<phase>1.90</phase>
			</component>
			<component>
				<amplitude>0.015</amplitude>
				<frequency>0.16</frequency>
				<phase>3.50</phase>
			</component>
			<component>
				<amplitude>0.010</amplitude>
				<frequency>0.22</frequency>
				<phase>5.90</phase>
			</component>
		</axis_y>

		<!-- HEAVE: strongest translational wave response -->
		<axis_z>
			<component>
				<amplitude>0.10</amplitude>
				<frequency>0.10</frequency>
				<phase>0.50</phase>
			</component>
			<component>
				<amplitude>0.18</amplitude>
				<frequency>0.16</frequency>
				<phase>2.10</phase>
			</component>
			<component>
				<amplitude>0.06</amplitude>
				<frequency>0.22</frequency>
				<phase>4.50</phase>
			</component>
		</axis_z>

		<!-- Small roll from slightly oblique sea -->
		<axis_roll>
			<component>
				<amplitude>0.0087</amplitude> <!-- 0.5 deg -->
				<frequency>0.10</frequency>
				<phase>1.60</phase>
			</component>
			<component>
				<amplitude>0.0140</amplitude> <!-- 0.8 deg -->
				<frequency>0.16</frequency>
				<phase>3.20</phase>
			</component>
			<component>
				<amplitude>0.0052</amplitude> <!-- 0.3 deg -->
				<frequency>0.22</frequency>
				<phase>5.60</phase>
			</component>
		</axis_roll>

		<!-- Pitch naturally stronger in a mainly head-on sea -->
		<axis_pitch>
			<component>
				<amplitude>0.0175</amplitude> <!-- 1.0 deg -->
				<frequency>0.10</frequency>
				<phase>0.90</phase>
			</component>
			<component>
				<amplitude>0.0349</amplitude> <!-- 2.0 deg -->
				<frequency>0.16</frequency>
				<phase>2.50</phase>
			</component>
			<component>
				<amplitude>0.0122</amplitude> <!-- 0.7 deg -->
				<frequency>0.22</frequency>
				<phase>4.90</phase>
			</component>
		</axis_pitch>

		<position_gain>20.0</position_gain>
		<max_linear_velocity>5.0</max_linear_velocity>

		<angular_enabled>true</angular_enabled>
		<angular_gain>10.0</angular_gain>
		<max_angular_velocity>1.0</max_angular_velocity>

	</plugin>



	<!-- Publishes /bee_platform/touched as gz.msgs.Boolean once the platform
	     contact sensor has touched the bee_x500 model continuously for 0.15 s.
	     The target string is intentionally broad: it should match bee_x500,
	     bee_x500_0, and scoped collision names containing the model name. -->
	<plugin filename="gz-sim-touchplugin-system"
		name="gz::sim::systems::TouchPlugin">
		<target>bee_x500</target>
		<namespace>bee_platform</namespace>
		<time>0.01</time>
		<enabled>true</enabled>
	</plugin>

	</model>

	<!-- Gazebo-native landing truth: WORLD plugin, not a model plugin. -->
	<plugin filename="libBeeLandingTruth.so" name="custom::BeeLandingTruth">
	<drone_model>bee_x500_0</drone_model>
	<platform_model>bee_platform</platform_model>

	<drone_base_link>base_link</drone_base_link>
	<camera_link>bee_camera_link</camera_link>
	<platform_link>platform_link</platform_link>

	<!-- True skid undersides, expressed in base_link coordinates. These are the
		physical feet, not the sensing-pad bottom 3 mm below them. -->
	<left_pad_point_base>0 -0.132 -0.227</left_pad_point_base>
	<right_pad_point_base>0 0.132 -0.227</right_pad_point_base>
	<skid_half_length_m>0.125</skid_half_length_m>
	<skid_half_width_m>0.0075</skid_half_width_m>
	
	<left_contact_topic>
	/world/bee_platform/model/bee_x500_0/link/bee_gear_contact_link/sensor/landing_gear_contact_sensor_left/contact
	</left_contact_topic>

	<right_contact_topic>
	/world/bee_platform/model/bee_x500_0/link/bee_gear_contact_link/sensor/landing_gear_contact_sensor_right/contact
	</right_contact_topic>

	<!-- platform_link origin is at the cylinder centre; top surface is +0.1 m. -->
	<platform_top_offset_m>0.1</platform_top_offset_m>

	<publish_rate_hz>100</publish_rate_hz>
	<truth_topic>/bee_land/truth</truth_topic>

	<!-- Raw contact sensors run at 250 Hz. A short SIM-time dwell rejects a
		one-message contact flicker without introducing wall/RTF dependence. -->
	<contact_confirmation_sec>0.04</contact_confirmation_sec>
	<contact_stale_timeout_sec>0.03</contact_stale_timeout_sec>
	<contact_target_substring>bee_platform</contact_target_substring>

	<!-- The defaults below reconstruct the auto-generated sensor topic names.
		Override left_contact_topic/right_contact_topic only if model names differ. -->
	<gear_link>bee_gear_contact_link</gear_link>
	<left_contact_sensor>landing_gear_contact_sensor_left</left_contact_sensor>
	<right_contact_sensor>landing_gear_contact_sensor_right</right_contact_sensor>

	<divergence_min_distance_m>0.05</divergence_min_distance_m>
	<minimum_view_alignment>0.90</minimum_view_alignment>
	</plugin>
</world>
</sdf>
